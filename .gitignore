# =============================================================================
# AEO Readiness Check — .gitignore
# =============================================================================

# 1. Environment variables & API Secrets (NEVER commit these)
.env
.env.*
!.env.example
.dev.vars

# 2. Node & Dependency directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Deployment & Hosting tool caches (Vercel / Cloudflare / Netlify / Render)
.vercel/
.turbo/
.wrangler/
.netlify/
.render/

# 4. Build & Temporary directories
dist/
build/
_site/
.cache/
.temp/
tmp/

# 5. Operating System files (Mac / Windows / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDE / Editor configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# 7. System logs, archives & temporary test artifacts
*.log
.system_generated/
archive/
